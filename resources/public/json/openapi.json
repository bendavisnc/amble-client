{
  "openapi" : "3.0.0",
  "info" : {
    "title" : "Amble",
    "version" : "0.0.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/game" : {
      "post" : {
        "operationId" : "gameCreate",
        "responses" : {
          "201" : {
            "description" : "Successfully created game."
          }
        },
        "summary" : "Create new game",
        "tags" : [ "game" ]
      }
    },
    "/game/{id}" : {
      "get" : {
        "operationId" : "gameGetById",
        "parameters" : [ {
          "description" : "The id of the game",
          "explode" : false,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "description" : "Game id of game that already exists."
          },
          "404" : {
            "description" : "No corresponding game found."
          }
        },
        "summary" : "Get game by id",
        "tags" : [ "game" ]
      }
    },
    "/game/{gameId}/player/{playerId}/move" : {
      "post" : {
        "operationId" : "moveAdd",
        "parameters" : [ {
          "description" : "The id of the game that the move takes place",
          "explode" : false,
          "in" : "path",
          "name" : "gameId",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        }, {
          "description" : "The id of the game player that makes the move",
          "explode" : false,
          "in" : "path",
          "name" : "playerId",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Move"
              }
            }
          },
          "description" : "The move the player makes.",
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Successfully made move."
          }
        },
        "summary" : "Adds player move to a game.",
        "tags" : [ "game" ]
      }
    },
    "/game/{gameId}/board" : {
      "get" : {
        "operationId" : "boardGetByGameId",
        "parameters" : [ {
          "description" : "The id of the game the board belongs to",
          "explode" : false,
          "in" : "path",
          "name" : "gameId",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "description" : "Coordinates that represent a game board."
          },
          "404" : {
            "description" : "No corresponding game found."
          }
        },
        "summary" : "Get board by game id",
        "tags" : [ "game" ]
      }
    },
    "/game/{gameId}/player" : {
      "get" : {
        "operationId" : "playerGetAllByGameId",
        "parameters" : [ {
          "description" : "The id of the game the players belong to",
          "explode" : false,
          "in" : "path",
          "name" : "gameId",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "description" : "Coordinates that represent a game board."
          },
          "404" : {
            "description" : "No corresponding game found."
          }
        },
        "summary" : "Get player by game id",
        "tags" : [ "game" ]
      }
    },
    "/game/{gameId}/player/{id}" : {
      "get" : {
        "operationId" : "playerGet",
        "parameters" : [ {
          "description" : "The id of the game the players belong to",
          "explode" : false,
          "in" : "path",
          "name" : "gameId",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        }, {
          "description" : "The id of the player",
          "explode" : false,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "description" : "Coordinates that represent the player's current state."
          },
          "404" : {
            "description" : "No corresponding game found."
          }
        },
        "summary" : "Get player",
        "tags" : [ "game" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "Coord" : {
        "items" : {
          "type" : "number"
        },
        "type" : "array"
      },
      "Move" : {
        "properties" : {
          "move" : {
            "items" : {
              "$ref" : "#/components/schemas/Coord"
            },
            "type" : "array"
          }
        },
        "type" : "object"
      }
    }
  }
}